# =============================================================================
# VENDEIA - Environment variables
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# =============================================================================

# -- Application ---------------------------------------------------------------
# Base URL of the app (used by Auth.js and future webhook callbacks).
NEXTAUTH_URL="http://localhost:3000"
NODE_ENV="development"

# -- Database (PostgreSQL) -----------------------------------------------------
# Relational database connection string used by Prisma.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vendeia?schema=public"

# -- Authentication ------------------------------------------------------------
# Secret used to sign session tokens. Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-generate-a-long-random-secret"

# =============================================================================
# The variables below are placeholders for FUTURE integrations.
# They are intentionally NOT used yet. Leave them empty for now.
# =============================================================================

# -- WhatsApp (WhatsApp Business / Cloud API) - NOT CONNECTED YET ---------------
# WHATSAPP_ACCESS_TOKEN=""
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_VERIFY_TOKEN=""
# WHATSAPP_APP_SECRET=""

# -- Logzz - NOT CONNECTED YET -------------------------------------------------
# LOGZZ_API_BASE_URL=""
# LOGZZ_API_KEY=""
# LOGZZ_WEBHOOK_SECRET=""

# -- AI provider - NOT CONNECTED YET -------------------------------------------
# AI_PROVIDER=""
# AI_API_KEY=""
# AI_MODEL=""
