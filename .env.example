# =============================================================================
# VENDEIA - Environment variables
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# =============================================================================

# -- Application ---------------------------------------------------------------
# Base URL of the app (used by Auth.js and future webhook callbacks).
NEXTAUTH_URL="http://localhost:3000"
NODE_ENV="development"

# -- Database (PostgreSQL) -----------------------------------------------------
# Relational database connection string used by Prisma.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vendeia?schema=public"

# -- Authentication ------------------------------------------------------------
# Secret used to sign session tokens. Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-generate-a-long-random-secret"

# -- AI provider (AI Sales Agent) ----------------------------------------------
# Which provider to use (currently only "openai" is implemented).
AI_PROVIDER="openai"
# OpenAI API key. If empty, the agent degrades gracefully: the panel shows a
# friendly "AI not configured" message and customer messages are still saved.
OPENAI_API_KEY=""
# Model override (optional). Defaults to gpt-4o-mini. Defined in ONE place
# (src/server/ai/config.ts) — never hardcoded elsewhere.
AI_MODEL="gpt-4o-mini"
# Audio transcription model (optional). Reuses OPENAI_API_KEY (no separate key).
# Defaults to gpt-4o-mini-transcribe. Defined in one place
# (src/server/ai/transcription/config.ts).
OPENAI_TRANSCRIPTION_MODEL="gpt-4o-mini-transcribe"

# =============================================================================
# The variables below are placeholders for FUTURE integrations.
# They are intentionally NOT used yet. Leave them empty for now.
# =============================================================================

# -- WhatsApp Business Platform / Cloud API ------------------------------------
# All optional: if absent, the integration is "not configured" (the app still
# runs and the webhook still answers verification). Read ONLY via
# src/server/integrations/whatsapp/config.ts.
# Permanent/system-user access token (Meta Business).
WHATSAPP_ACCESS_TOKEN=""
# Phone Number ID of the WhatsApp sender (WhatsApp > API Setup).
WHATSAPP_PHONE_NUMBER_ID=""
# WhatsApp Business Account (WABA) ID.
WHATSAPP_BUSINESS_ACCOUNT_ID=""
# Any string you choose; must match the "Verify token" set in the Meta webhook.
WHATSAPP_VERIFY_TOKEN=""
# Graph API version (optional; defaults to v21.0).
WHATSAPP_API_VERSION="v21.0"
# App Secret (Meta App > Settings > Basic). Enables X-Hub-Signature-256
# verification of inbound webhooks. Strongly recommended in production.
WHATSAPP_APP_SECRET=""
# Max size (bytes) of an inbound audio to download/transcribe (default 16MB).
WHATSAPP_AUDIO_MAX_BYTES="16777216"

# -- Logzz ---------------------------------------------------------------------
# Logzz has NO public REST API for creating orders or querying delivery/status,
# so there is intentionally NO api url/token. Integration = inbound order
# webhook (panel-configured) + checkout links stored on the product.
# Shared secret used to authenticate inbound Logzz webhooks. The merchant embeds
# it in the configured webhook URL (?token=...) or the x-logzz-token header.
LOGZZ_WEBHOOK_SECRET=""
